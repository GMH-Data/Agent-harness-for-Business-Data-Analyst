aptop_model_id\": null, \"session_id\": \"50fdefad-3331-4ae2-b869-7c255aa86e5e\"}, {\"event_id\": \"755504\", \"event_name\": \"search_for_device\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": null, \"session_id\": \"50fdefad-3331-4ae2-b869-7c255aa86e5e\"}, {\"event_id\": \"755505\", \"event_name\": \"pageview\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": null, \"session_id\": \"837f1441-3806-4c4f-9968-39faff0b5306\"}, {\"event_id\": \"755506\", \"event_name\": \"pageview\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": null, \"session_id\": \"837f1441-3806-4c4f-9968-39faff0b5306\"}, {\"event_id\": \"755507\", \"event_name\": \"load_more_device_home\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": null, \"session_id\": \"837f1441-3806-4c4f-9968-39faff0b5306\"}, {\"event_id\": \"755508\", \"event_name\": \"pageview\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": \"5\", \"session_id\": \"294510bc-0ae5-482a-93bb-1485c6f2ccf2\"}, {\"event_id\": \"755509\", \"event_name\": \"pageview\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": \"20\", \"session_id\": \"f354c3d2-be64-4b10-b802-8247a6767d90\"}, {\"event_id\": \"755510\", \"event_name\": \"pageview\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": null, \"session_id\": \"f354c3d2-be64-4b10-b802-8247a6767d90\"}, {\"event_id\": \"755511\", \"event_name\": \"load_more_device_home\", \"event_date\": \"2026-08-18\", \"laptop_model_id\": null, \"session_id\": \"f354c3d2-be64-4b10-b802-8247a6767d90\"}]",
      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\n-- Extract only required columns and apply the 30-day date filter immediately to optimize scan costs\nraw_extraction AS (\n    SELECT \n        event_id,\n        event_name,\n        event_date,\n        laptop_model_id,\n        session_id\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking`\n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n),\n\n-- 2. Standardization and Cleaning\n-- Handle potential NULLs and ensure data types are consistent\nstandardization_and_cleaning AS (\n    SELECT \n        CAST(event_id AS STRING) AS event_id,\n        COALESCE(LOWER(TRIM(event_name)), 'unknown_event') AS event_name,\n        event_date,\n        CAST(laptop_model_id AS STRING) AS laptop_model_id,\n        COALESCE(CAST(session_id AS STRING), 'unknown_session') AS session_id,\n        -- Deduplication logic to ensure we don't have duplicate event IDs\n        ROW_NUMBER() OVER (\n            PARTITION BY event_id \n            ORDER BY event_date DESC\n        ) as row_num\n    FROM raw_extraction\n),\n\n-- 3. Final Presentation\n-- Filter for unique records and format the date for the dashboard\nfinal_presentation AS (\n    SELECT \n        event_id,\n        event_name,\n        FORMAT_DATE('%Y-%m-%d', event_date) AS event_date,\n        laptop_model_id,\n        session_id\n    FROM standardization_and_cleaning\n    WHERE row_num = 1\n)\n\n-- Output the detailed event list sorted by date descending for deep-dive analysis\nSELECT \n    event_id,\n    event_name,\n    event_date,\n    laptop_model_id,\n    session_id\nFROM final_presentation\nORDER BY \n    event_date DESC,\n    event_id ASC;"
    }
  ],
  "current_section_index": 7
}

