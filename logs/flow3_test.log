  "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\n-- Filter for the last 30 days to optimize scan costs and meet the timeframe requirement\nraw_extraction AS (\n    SELECT \n        session_id,\n        event_date\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking` \n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n      AND session_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\n-- Ensure session IDs are treated as strings and remove any potential duplicates\nstandardization_and_cleaning AS (\n    SELECT \n        CAST(session_id AS STRING) AS session_id,\n        event_date\n    FROM raw_extraction\n),\n\n-- 3. Aggregation Layer\n-- Calculate the total number of unique sessions\naggregation_layer AS (\n    SELECT \n        COUNT(DISTINCT session_id) AS total_sessions\n    FROM standardization_and_cleaning\n),\n\n-- 4. Final Presentation\n-- Format the output for the dashboard KPI section\nfinal_presentation AS (\n    SELECT \n        CAST(total_sessions AS STRING) AS total_sessions_count,\n        'Last 30 Days' AS timeframe\n    FROM aggregation_layer\n)\n\n-- Final output for the KPI card\nSELECT * \nFROM final_presentation;",
