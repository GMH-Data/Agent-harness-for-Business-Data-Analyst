      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\nraw_extraction AS (\n    SELECT \n        f.event_id,\n        f.event_date,\n        f.device_key,\n        d.device_type\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking` AS f\n    INNER JOIN `ai-riser-505908.laplaptech_marketing.dim_devices` AS d \n        ON f.device_key = d.device_key\n    WHERE f.event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n),\n\n-- 2. Data Cleaning & Standardization\nstandardization_and_cleaning AS (\n    SELECT \n        event_id,\n        COALESCE(device_type, 'Unknown') AS clean_device_type\n    FROM raw_extraction\n),\n\n-- 3. Aggregation Layer\naggregation_layer AS (\n    SELECT \n        clean_device_type,\n        COUNT(event_id) AS total_interactions\n    FROM standardization_and_cleaning\n    GROUP BY \n        clean_device_type\n),\n\n-- 4. Final Presentation\nfinal_presentation AS (\n    SELECT \n        clean_device_type AS device_type,\n        total_interactions\n    FROM aggregation_layer\n)\n\nSELECT * \nFROM final_presentation\nORDER BY total_interactions DESC;"
    },
