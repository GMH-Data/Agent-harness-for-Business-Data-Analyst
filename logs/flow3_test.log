{
  "dashboard_sections": [
    {
      "section_id": "row1_kpi_total_events",
      "section_goal": "Show the total number of interactions (events) as a proxy for potential revenue growth",
      "chart_config": {
        "chart_type": "big_number",
        "chart_name": "Tổng số lượt tương tác (30 ngày qua)",
        "metrics": [
          "SUM(total_events)"
        ],
        "groupby": [],
        "time_column": "null",
        "filters": "null",
        "chart_config_extra": "{\"color\": \"#2ecc71\", \"font_size\": \"large\"}"
      },
      "raw_data": "[{\"total_events\": 4822, \"metric_name\": \"Total Interactions (Last 30 Days)\"}]",
      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\n-- Extract only necessary columns and apply the 30-day date filter immediately to optimize cost\nraw_extraction AS (\n    SELECT \n        event_id,\n        event_date\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking`\n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n),\n\n-- 2. Standardization and Cleaning\n-- Ensure event_id is not null and remove any potential duplicates to ensure an accurate count\nstandardization_and_cleaning AS (\n    SELECT \n        event_id,\n        -- Using ROW_NUMBER to handle potential duplicate event_id entries\n        ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY event_date DESC) as row_num\n    FROM raw_extraction\n    WHERE event_id IS NOT NULL\n),\n\n-- 3. Aggregation Layer\n-- Calculate the total count of unique events\naggregation_layer AS (\n    SELECT \n        COUNT(event_id) AS total_events\n    FROM standardization_and_cleaning\n    WHERE row_num = 1\n),\n\n-- 4. Final Presentation\n-- Format the output for the KPI card\nfinal_presentation AS (\n    SELECT \n        total_events,\n        'Total Interactions (Last 30 Days)' AS metric_name\n    FROM aggregation_layer\n)\n\n-- Final output for the dashboard section row1_kpi_total_events\nSELECT \n    total_events, \n    metric_name \nFROM final_presentation;"
    },
    {
      "section_id": "row1_kpi_sessions",
      "section_goal": "Measure user engagement level through total sessions",
      "chart_config": {
        "chart_type": "big_number",
        "chart_name": "Tổng số phiên truy cập",
        "metrics": [
          "total_sessions_count"
        ],
        "groupby": [],
        "time_column": "timeframe",
        "filters": "",
        "chart_config_extra": "{\"color\": \"#2ecc71\", \"font_size\": \"24px\"}"
      },
      "raw_data": "[{\"total_sessions_count\": \"506\", \"timeframe\": \"Last 30 Days\"}]",
      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\n-- Filter for the last 30 days to optimize scan costs and meet the timeframe requirement\nraw_extraction AS (\n    SELECT \n        session_id,\n        event_date\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking` \n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n      AND session_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\n-- Ensure session IDs are treated as strings and remove any potential duplicates\nstandardization_and_cleaning AS (\n    SELECT \n        CAST(session_id AS STRING) AS session_id,\n        event_date\n    FROM raw_extraction\n),\n\n-- 3. Aggregation Layer\n-- Calculate the total number of unique sessions\naggregation_layer AS (\n    SELECT \n        COUNT(DISTINCT session_id) AS total_sessions\n    FROM standardization_and_cleaning\n),\n\n-- 4. Final Presentation\n-- Format the output for the dashboard KPI section\nfinal_presentation AS (\n    SELECT \n        CAST(total_sessions AS STRING) AS total_sessions_count,\n        'Last 30 Days' AS timeframe\n    FROM aggregation_layer\n)\n\n-- Final output for the KPI card\nSELECT * \nFROM final_presentation;"
    },
    {
      "section_id": "row1_kpi_revenue_proxy",
      "section_goal": "Show the total number of 'purchase' events as a direct indicator of revenue",
      "chart_config": {
        "chart_type": "big_number",
        "chart_name": "Tổng số đơn hàng (30 ngày qua)",
        "metrics": [
          "total_purchase_events"
        ],
        "groupby": [],
        "time_column": "",
        "filters": "",
        "chart_config_extra": ""
      },
      "raw_data": "[{\"metric_label\": \"Total Purchases (Last 30 Days)\", \"total_purchase_events\": 0}]",
      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\nraw_extraction AS (\n    SELECT \n        event_id,\n        event_name,\n        event_date\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking` \n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n      AND event_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\nstandardization_and_cleaning AS (\n    SELECT \n        event_id,\n        LOWER(TRIM(event_name)) AS event_name,\n        event_date\n    FROM raw_extraction\n),\n\n-- 3. Aggregation Layer\naggregation_layer AS (\n    SELECT \n        COUNT(event_id) AS total_purchase_events\n    FROM standardization_and_cleaning\n    WHERE event_name = 'purchase'\n),\n\n-- 4. Final Presentation\nfinal_presentation AS (\n    SELECT \n        total_purchase_events,\n        -- Adding a descriptive label for the KPI\n        'Total Purchases (Last 30 Days)' AS metric_label\n    FROM aggregation_layer\n)\n\n-- Output the final dataset for the KPI card\nSELECT \n    metric_label,\n    total_purchase_events\nFROM final_presentation;"
    },
    {
      "section_id": "row2_trend_events",
      "section_goal": "Analyze the trend of user interactions over time to identify peak periods",
      "chart_config": {
        "chart_type": "line",
        "chart_name": "Xu hướng tương tác của người dùng theo thời gian",
        "metrics": [
          "SUM(total_events)"
        ],
        "groupby": [],
        "time_column": "event_date",
        "filters": "",
        "chart_config_extra": "{\"sort\": \"event_date ASC\", \"colors\": [\"#2196F3\"]}"
      },
      "raw_data": "[{\"event_date\": \"2026-08-18\", \"total_events\": 1640}, {\"event_date\": \"2026-08-19\", \"total_events\": 1660}, {\"event_date\": \"2026-08-25\", \"total_events\": 1183}, {\"event_date\": \"2026-08-26\", \"total_events\": 922}, {\"event_date\": \"2026-08-27\", \"total_events\": 376}, {\"event_date\": \"2026-08-28\", \"total_events\": 523}, {\"event_date\": \"2026-08-29\", \"total_events\": 583}]",
      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\nraw_events AS (\n    SELECT \n        event_id,\n        event_date,\n        event_name\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking` \n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n      AND event_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\ncleaned_events AS (\n    SELECT \n        event_id,\n        event_date,\n        -- Standardize event names to avoid case sensitivity issues\n        LOWER(TRIM(event_name)) AS event_name\n    FROM raw_events\n),\n\n-- 3. Aggregation Layer (Daily Event Counts)\naggregation_layer AS (\n    SELECT \n        event_date,\n        COUNT(event_id) AS total_events\n    FROM cleaned_events\n    GROUP BY \n        event_date\n),\n\n-- 4. Final Presentation & Formatting\nfinal_presentation AS (\n    SELECT \n        FORMAT_DATE('%Y-%m-%d', event_date) AS event_date,\n        total_events\n    FROM aggregation_layer\n)\n\n-- Output the final dataset sorted by date for trend analysis\nSELECT * \nFROM final_presentation\nORDER BY \n    event_date ASC;"
    },
