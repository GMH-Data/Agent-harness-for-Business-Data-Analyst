W\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"ASUS Vivobook S 14 OLED S5406MA-PP198WS\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"Asus ROG Zephyrus G16 (2025)\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"ASUS Vivobook S14 OLED M5406KA-PP134WS\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"ExpertBook P1 (P1403)\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"Asus TUF A14 (2025)\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"ASUS Vivobook S14 OLED\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"MSI\", \"laptop_name\": \"MSI Titan 18 HX AI A2XW\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Lenovo\", \"laptop_name\": \"ThinkPad T14s Gen 6\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"ASUS Vivobook S 14 OLED (S5406)\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"ASUS Zenbook 14 OLED UX3405MA-PP152W\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Lenovo\", \"laptop_name\": \"Lenovo ThinkPad X1 Carbon Gen 12\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"Asus Vivobook S 14\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}, {\"laptop_brand\": \"Asus\", \"laptop_name\": \"Asus Zenbook S 16\", \"total_interactions\": 2, \"interaction_share_pct\": 0.17}]",
      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\nraw_events AS (\n    SELECT \n        event_id,\n        event_date,\n        laptop_model_id\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking` \n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n      AND laptop_model_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\ncleaned_events AS (\n    SELECT \n        event_id,\n        laptop_model_id,\n        -- Ensure laptop_model_id is treated as a string for consistent joining\n        CAST(laptop_model_id AS STRING) AS clean_laptop_model_id\n    FROM raw_events\n),\n\n-- 3. Aggregation Layer: Count interactions per laptop model\nmodel_interactions AS (\n    SELECT \n        clean_laptop_model_id,\n        COUNT(event_id) AS total_interactions\n    FROM cleaned_events\n    GROUP BY 1\n),\n\n-- 4. Enrichment Layer: Join with Laptop Dimension table to get human-readable names\nmodel_details AS (\n    SELECT \n        mi.clean_laptop_model_id,\n        mi.total_interactions,\n        COALESCE(dim.laptop_name, 'Unknown Model') AS laptop_name,\n        COALESCE(dim.laptop_brand, 'Unknown Brand') AS laptop_brand\n    FROM model_interactions mi\n    LEFT JOIN `ai-riser-505908.laplaptech_hardware.dim_laptops_obt` dim \n        ON mi.clean_laptop_model_id = CAST(dim.laptop_model_id AS STRING)\n),\n\n-- 5. Final Presentation: Formatting and Ranking\nfinal_presentation AS (\n    SELECT \n        laptop_brand,\n        laptop_name,\n        total_interactions,\n        -- Calculate the percentage of total interactions to provide more context\n        ROUND(\n            SAFE_DIVIDE(total_interactions, SUM(total_interactions) OVER()), \n            4\n        ) * 100 AS interaction_share_pct\n    FROM model_details\n)\n\n-- Output the final dataset sorted by popularity (most interactions first)\nSELECT \n    laptop_brand,\n    laptop_name,\n    total_interactions,\n    ROUND(interaction_share_pct, 2) AS interaction_share_pct\nFROM final_presentation\nORDER BY \n    total_interactions DESC\nLIMIT 100;"
    },
