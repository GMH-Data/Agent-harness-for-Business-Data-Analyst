      "sql_query": "WITH \n-- 1. Raw Data Extraction & Hard Filtering\n-- Extract only necessary columns and apply the 30-day date filter immediately to optimize cost\nraw_extraction AS (\n    SELECT \n        event_id,\n        event_date\n    FROM `ai-riser-505908.laplaptech_marketing.fct_user_event_tracking`\n    WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)\n),\n\n-- 2. Standardization and Cleaning\n-- Ensure event_id is not null and remove any potential duplicates to ensure an accurate count\nstandardization_and_cleaning AS (\n    SELECT \n        event_id,\n        -- Using ROW_NUMBER to handle potential duplicate event_id entries\n        ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY event_date DESC) as row_num\n    FROM raw_extraction\n    WHERE event_id IS NOT NULL\n),\n\n-- 3. Aggregation Layer\n-- Calculate the total count of unique events\naggregation_layer AS (\n    SELECT \n        COUNT(event_id) AS total_events\n    FROM standardization_and_cleaning\n    WHERE row_num = 1\n),\n\n-- 4. Final Presentation\n-- Format the output for the KPI card\nfinal_presentation AS (\n    SELECT \n        total_events,\n        'Total Interactions (Last 30 Days)' AS metric_name\n    FROM aggregation_layer\n)\n\n-- Final output for the dashboard section row1_kpi_total_events\nSELECT \n    total_events, \n    metric_name \nFROM final_presentation;"
