data: {"type": "node_finish", "node": "sql_extractor", "data": {"sql_query": "WITH \n-- 1. Raw Data Extraction\nraw_laptop_data AS (\n    SELECT \n        laptop_model_id, \n        laptop_name, \n        mobility_score \n    FROM `ai-riser-505908.laplaptech_hardware.dim_laptops_obt` \n    WHERE laptop_model_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\ncleaned_laptop_data AS (\n    SELECT \n        laptop_model_id, \n        laptop_name, \n        COALESCE(mobility_score, 0) AS mobility_score\n    FROM raw_laptop_data\n),\n\n-- 3. Aggregation Layer: Calculate average stability/mobility score across all machines\n-- Note: Based on the provided schema, 'mobility_score' is the closest proxy for a stability/performance metric available in the hardware table.\nstability_metrics AS (\n    SELECT \n        AVG(mobility_score) AS avg_stability_score\n    FROM cleaned_laptop_data\n),\n\n-- 4. Final Presentation\nfinal_presentation AS (\n    SELECT \n        ROUND(avg_stability_score, 2) AS average_system_stability_score\n    FROM stability_metrics\n)\n\nSELECT * \nFROM final_presentation;", "raw_data": "[{\"average_system_stability_score\": 3.98}]", "accumulated_data": [{"subtask": "Truy v\u1ea5n gi\u00e1 tr\u1ecb trung b\u00ecnh c\u1ee7a ch\u1ec9 s\u1ed1 \u1ed5n \u0111\u1ecbnh cho t\u1ea5t c\u1ea3 c\u00e1c m\u00e1y trong h\u1ec7 th\u1ed1ng.", "raw_data": "[{\"average_system_stability_score\": 3.98}]"}]}}
