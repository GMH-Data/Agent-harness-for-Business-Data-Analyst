data: {"type": "node_finish", "node": "sql_extractor", "data": {"sql_query": "WITH \n-- 1. Raw Data Extraction\nraw_hardware_data AS (\n    SELECT \n        laptop_model_id,\n        laptop_name,\n        laptop_brand,\n        office_battery_result_minutes,\n        gaming_battery_result_minutes,\n        mobility_score\n    FROM `ai-riser-505908.laplaptech_hardware.dim_laptops_obt` \n    WHERE laptop_model_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\ncleaned_hardware_data AS (\n    SELECT \n        laptop_model_id,\n        laptop_name,\n        laptop_brand,\n        COALESCE(office_battery_result_minutes, 0) AS office_battery_min,\n        COALESCE(gaming_battery_result_minutes, 0) AS gaming_battery_min,\n        COALESCE(mobility_score, 0) AS mobility_score,\n        -- Standardize brand names to avoid duplicates due to casing\n        UPPER(TRIM(laptop_brand)) AS standardized_brand\n    FROM raw_hardware_data\n),\n\n-- 3. Metric Calculation (Defining 'Stability' as a composite score of battery performance and mobility)\n-- Since 'stability' isn't a direct column, we derive it from the available hardware metrics\nstability_metrics AS (\n    SELECT \n        laptop_model_id,\n        laptop_name,\n        standardized_brand,\n        office_battery_min,\n        gaming_battery_min,\n        mobility_score,\n        -- Calculate a composite stability score: Average of normalized battery results and mobility score\n        -- We assume higher battery life and mobility score indicate a more 'stable' and reliable hardware configuration\n        (SAFE_DIVIDE(office_battery_min, 60) + SAFE_DIVIDE(gaming_battery_min, 60) + mobility_score) / 3 AS raw_stability_score\n    FROM cleaned_hardware_data\n),\n\n-- 4. Aggregation Layer (Calculating the system-wide average stability)\nsystem_wide_stability AS (\n    SELECT \n        AVG(raw_stability_score) AS avg_system_stability_score\n    FROM stability_metrics\n),\n\n-- 5. Final Presentation\nfinal_presentation AS (\n    SELECT \n        'System-wide Average Stability' AS metric_name,\n        ROUND(avg_system_stability_score, 2) AS average_stability_value\n    FROM system_wide_stability\n)\n\nSELECT * \nFROM final_presentation;", "raw_data": "[{\"metric_name\": \"System-wide Average Stability\", \"average_stability_value\": 1.35}]", "accumulated_data": [{"subtask": "Truy v\u1ea5n ch\u1ec9 s\u1ed1 \u0111\u1ed9 \u1ed5n \u0111\u1ecbnh trung b\u00ecnh c\u1ee7a to\u00e0n b\u1ed9 h\u1ec7 th\u1ed1ng m\u00e1y m\u00f3c hi\u1ec7n c\u00f3.", "raw_data": "[{\"metric_name\": \"System-wide Average Stability\", \"average_stability_value\": 1.35}]"}]}}
