data: {"type": "node_finish", "node": "sql_extractor", "data": {"sql_query": "WITH \n-- 1. Raw Data Extraction\nraw_laptop_data AS (\n    SELECT \n        laptop_model_id,\n        laptop_name,\n        laptop_brand,\n        cpu_name,\n        gpu_name,\n        office_battery_result_minutes,\n        gaming_battery_result_minutes,\n        mobility_score\n    FROM `ai-riser-505908.laplaptech_hardware.dim_laptops_obt` \n    WHERE laptop_model_id IS NOT NULL\n),\n\n-- 2. Data Cleaning & Standardization\ncleaned_laptop_data AS (\n    SELECT \n        laptop_model_id,\n        laptop_name,\n        LOWER(TRIM(laptop_brand)) AS laptop_brand,\n        cpu_name,\n        gpu_name,\n        COALESCE(office_battery_result_minutes, 0) AS office_battery_min,\n        COALESCE(gaming_battery_result_minutes, 0) AS gaming_battery_min,\n        COALESCE(mobility_score, 0) AS mobility_score\n    FROM raw_laptop_data\n),\n\n-- 3. Stability Metric Calculation\n-- Since 'stability' is not a direct column, we define it as a composite score \n-- based on battery performance (office and gaming) and mobility score.\n-- Higher battery life and mobility score generally indicate a more 'stable' and reliable \n-- high-performance machine for various workloads.\nstability_metrics AS (\n    SELECT \n        *,\n        -- Normalize battery results to a 0-100 scale relative to the max in the dataset\n        -- Using SAFE_DIVIDE to prevent division by zero\n        SAFE_DIVIDE(office_battery_min, MAX(office_battery_min) OVER()) * 100 AS norm_office_battery,\n        SAFE_DIVIDE(gaming_battery_min, MAX(gaming_battery_min) OVER()) * 100 AS norm_gaming_battery,\n        SAFE_DIVIDE(mobility_score, MAX(mobility_score) OVER()) * 100 AS norm_mobility\n    FROM cleaned_laptop_data\n),\n\n-- 4. Aggregation Layer\n-- We calculate a final stability score by averaging the normalized values\naggregated_stability AS (\n    SELECT \n        laptop_model_id,\n        laptop_name,\n        laptop_brand,\n        cpu_name,\n        gpu_name,\n        -- Composite stability score: Average of normalized battery and mobility\n        ROUND(SAFE_DIVIDE(norm_office_battery + norm_gaming_battery + norm_mobility, 3), 2) AS stability_score,\n        office_battery_min,\n        gaming_battery_min,\n        mobility_score\n    FROM stability_metrics\n),\n\n-- 5. Final Presentation\nfinal_presentation AS (\n    SELECT \n        laptop_name AS device_name,\n        laptop_brand AS brand,\n        cpu_name AS processor,\n        gpu_name AS graphics_card,\n        stability_score,\n        office_battery_min AS office_battery_life,\n        gaming_battery_min AS gaming_battery_life,\n        mobility_score AS mobility_rating\n    FROM aggregated_stability\n)\n\n-- Output the final dataset sorted by stability score descending to find the most stable machine\nSELECT * \nFROM final_presentation\nORDER BY \n    stability_score DESC\nLIMIT 100;", "raw_data": "[{\"device_name\": \"LG gram 16 (2025)\", \"brand\": \"lg\", \"processor\": \"Intel Core Ultra 5 226V\", \"graphics_card\": \"Intel Arc Graphics 130V\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"ASUS Vivobook S14 OLED M5406KA-PP134WS\", \"brand\": \"asus\", \"processor\": \"AMD Ryzen AI 7 350\", \"graphics_card\": \"AMD Radeon 860M\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Expertbook P5\", \"brand\": \"asus\", \"processor\": \"Intel Core Ultra 7 258V\", \"graphics_card\": \"Intel Arc Graphics 140V (t\u00edch h\u1ee3p)\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Lenovo LOQ 15IAX9\", \"brand\": \"lenovo\", \"processor\": \"Intel Core i5-12450H\", \"graphics_card\": \"NVIDIA RTX 2050\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Acer Swift 14 AI SF14-11T SF14-11T-X1M5\", \"brand\": \"acer\", \"processor\": \"Qualcomm Snapdragon X Elite X1E 78 100\", \"graphics_card\": \"Qualcomm Adreno GPU\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"ASUS Vivobook S 14 OLED S5406MA-PP198WS\", \"brand\": \"asus\", \"processor\": \"Intel Core Ultra 7 155H\", \"graphics_card\": \"Intel Arc Graphics 140V (t\u00edch h\u1ee3p)\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Apple MacBook Pro 16 M5 Max\", \"brand\": \"apple\", \"processor\": \"Apple M5 Max\", \"graphics_card\": \"Apple M5 Max GPU 40-core\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"iPad Air M3 11 inch\", \"brand\": \"apple\", \"processor\": \"Apple M3\", \"graphics_card\": \"Apple M3\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Acer Predator Helios Neo 14 PHN14-51-99Y8\", \"brand\": \"acer\", \"processor\": \"Intel Core Ultra 9 185H\", \"graphics_card\": \"NVIDIA RTX 4060\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Apple MacBook Air M4 13 inch\", \"brand\": \"apple\", \"processor\": \"Apple M4\", \"graphics_card\": \"Apple M4\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"HP Gaming Victus 16-r1182TX A2NN6PA\", \"brand\": \"hp\", \"processor\": \"Intel Core i5-14450HX\", \"graphics_card\": \"NVIDIA RTX 4050\", \"stability_score\": null, \"office_battery_life\": 0.0, \"gaming_battery_life\": 0.0, \"mobility_rating\": 0.0}, {\"device_name\": \"Acer Predat